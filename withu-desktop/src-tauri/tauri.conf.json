{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WithU",
  "version": "1.0.0",
  "identifier": "love.withu.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WithU",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 640,
        "center": true,
        "url": "https://gzr.xjy.xn--6qq986b3xl/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
